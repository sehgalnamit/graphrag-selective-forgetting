# Copy to .env to customize local runs. All values shown are defaults.
# docker-compose.yml sets its own equivalent environment variables for the
# containerized services; this file is for running `app`/`decay_engine`
# directly on the host (e.g. `uvicorn app.main:app --reload`).

APP_NAME=graphrag-selective-forgetting
ENVIRONMENT=local

# Set to "false" to use real Neo4j/Qdrant (requires docker-compose up).
USE_FAKE_STORES=true

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_SIZE=384

# auto | sentence-transformers | fake
EMBEDDER_BACKEND=auto
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=20

DECAY_HALF_LIFE_HOURS=168
DECAY_REINFORCEMENT_FACTOR=0.15
DECAY_REINFORCEMENT_CAP=20
DECAY_INTERVAL_SECONDS=300
PRUNE_THRESHOLD=0.15
PRUNE_GRACE_PERIOD_HOURS=24
JURY_BORDERLINE_MARGIN=0.05
JURY_GATE_ENABLED=true

JURY_PANEL_SIZE=3
JURY_ABSTAIN_MARGIN=0.15
JURY_OLLAMA_ENABLED=false
JURY_OLLAMA_URL=http://localhost:11434
JURY_OLLAMA_MODELS=

AUDIT_DB_PATH=./data/audit_log.sqlite3

RETRIEVAL_TOP_K=5
RETRIEVAL_GRAPH_HOPS=2
